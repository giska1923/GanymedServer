# Copy to .env (gitignored) and replace both secrets.
#
# Generate a secret with, for example:
#   openssl rand -base64 48
# or in PowerShell (a CSPRNG; Get-Random is not one and must not be used for secrets):
#   $b = New-Object byte[] 48; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)

POSTGRES_PASSWORD=change-me

# At least 32 bytes. Signs every access token; changing it logs everyone out.
GS_JWT_SECRET=change-me-to-at-least-32-random-bytes

# debug, info, warn, error
GS_LOG_LEVEL=info

# For running the backend on the host (VS Code debugger, go run). Compose ignores this: it builds
# its own URL with the in-network hostname "postgres". Same password as above.
GS_DATABASE_URL=postgres://ganymed:change-me@localhost:5433/ganymed?sslmode=disable

# For `go test` on the host: integration tests use this database and skip when it is unset.
TEST_DATABASE_URL=postgres://ganymed:change-me@localhost:5433/ganymed?sslmode=disable

# Redis from the host (debugger, go run, tests). Compose ignores GS_REDIS_URL: inside its network
# the host is "redis". Tests claim databases 1-15 themselves; the /0 here is only the lock database.
GS_REDIS_URL=redis://localhost:6379/0
TEST_REDIS_URL=redis://localhost:6379/0

# Signs connect tokens (B5): a base64 Ed25519 seed, 32 bytes. Game servers only ever get the public
# key. Generate with:  openssl rand -base64 32
GS_CONNECT_TOKEN_KEY=change-me-to-a-base64-32-byte-seed

# Fleet agents authenticate with this (B5). At least 32 bytes. cmd/fleetagent reads the same
# variable, so the agent and the backend share it.
GS_FLEET_AGENT_SECRET=change-me-to-at-least-32-random-bytes
